# Django Production Environment Variables

# --------------------------------------------------
# BASIC DJANGO SETTINGS
# --------------------------------------------------
# Generate a new secret key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# URL of the frontend app, used to build links in emails (invitations,
# password resets)
FRONTEND_URL=https://yourdomain.com

# Gunicorn worker count (PORT itself is injected by Railway automatically,
# no need to set it)
WEB_CONCURRENCY=3

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Comma-separated list of origins Django trusts for unsafe (POST/PUT/...)
# requests -- required once the app sits behind a proxy like Railway's edge.
# Same URL(s) as DJANGO_ALLOWED_HOSTS, but with the scheme, e.g.:
# https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --------------------------------------------------
# DATABASE SETTINGS
# --------------------------------------------------
# PostgreSQL database URL -- on Railway this is injected automatically by
# the Postgres plugin, no need to set it by hand.
DATABASE_URL=postgres://username:password@host:5432/database_name
# Set to 1 only if connecting over a proxy that requires SSL (Railway's
# internal Postgres connection doesn't).
DATABASE_SSL_REQUIRE=0

# --------------------------------------------------
# CORS SETTINGS
# --------------------------------------------------
# Comma-separated list of allowed origins for frontend
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --------------------------------------------------
# REDIS SETTINGS
# --------------------------------------------------
# Redis URL for caching and Celery -- on Railway this is injected
# automatically by the Redis plugin as REDIS_URL; CELERY_BROKER_URL/
# CELERY_RESULT_BACKEND only need setting if they should differ from it.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --------------------------------------------------
# FILE STORAGE (Cloudflare R2 / any S3-compatible bucket)
# --------------------------------------------------
# Leave AWS_STORAGE_BUCKET_NAME unset to keep serving media from local
# disk (fine for a self-hosted box with a persistent volume; on Railway
# the filesystem is ephemeral, so uploaded/generated files would vanish
# on the next deploy -- set these to persist them in R2 instead).
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# Public bucket domain (an r2.dev subdomain, or your own domain mapped to
# the bucket) -- when set, media URLs are plain and unsigned. Leave unset
# to keep the bucket private and use signed URLs instead.
AWS_S3_CUSTOM_DOMAIN=

# --------------------------------------------------
# EMAIL SETTINGS
# --------------------------------------------------
# SMTP email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --------------------------------------------------
# SECURITY SETTINGS
# --------------------------------------------------
# Enable SSL redirect (set to 1 for production)
SECURE_SSL_REDIRECT=1

# --------------------------------------------------
# LOGGING SETTINGS
# --------------------------------------------------
# Log file path (optional)
LOG_FILE=/var/log/django/crm.log

# --------------------------------------------------
# MONITORING (Optional)
# --------------------------------------------------
# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# --------------------------------------------------
# STRIPE SETTINGS (payment links)
# --------------------------------------------------
# Leave unset in dev -- billing/payment-links/ shows a clear error
# instead of creating a link when these aren't configured.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --------------------------------------------------
# ANTHROPIC SETTINGS (AI content generation)
# --------------------------------------------------
# Leave unset in dev -- /ai-content/ shows a clear error on the job
# instead of generating content when this isn't configured.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# --------------------------------------------------
# STABILITY AI SETTINGS (AI image/video generation)
# --------------------------------------------------
# Leave unset in dev -- /ai-content/ shows a clear error on the job
# instead of generating an image/video when this isn't configured.
STABILITY_API_KEY=sk-your-stability-api-key
