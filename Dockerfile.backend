FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=crm_project.settings_production

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_production.txt /app/
RUN pip install --no-cache-dir -r requirements_production.txt

COPY . /app/

RUN mkdir -p /app/staticfiles /app/media /var/log/django

# Jei collectstatic veikia be runtime env problemų, palik čia.
# Jei ne, perkelk į entrypoint.sh
RUN python manage.py collectstatic --noinput --settings=crm_project.settings_production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

CMD ["gunicorn", "crm_project.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "--max-requests", "1000", "--max-requests-jitter", "100"]