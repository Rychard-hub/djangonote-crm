# Django Production Environment Variables

# --------------------------------------------------
# BASIC DJANGO SETTINGS
# --------------------------------------------------
# Generate a new secret key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# --------------------------------------------------
# DATABASE SETTINGS
# --------------------------------------------------
# PostgreSQL database URL
DATABASE_URL=postgres://username:password@host:5432/database_name

# --------------------------------------------------
# CORS SETTINGS
# --------------------------------------------------
# Comma-separated list of allowed origins for frontend
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --------------------------------------------------
# REDIS SETTINGS
# --------------------------------------------------
# Redis URL for caching and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --------------------------------------------------
# EMAIL SETTINGS
# --------------------------------------------------
# SMTP email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --------------------------------------------------
# SECURITY SETTINGS
# --------------------------------------------------
# Enable SSL redirect (set to 1 for production)
SECURE_SSL_REDIRECT=1

# --------------------------------------------------
# LOGGING SETTINGS
# --------------------------------------------------
# Log file path (optional)
LOG_FILE=/var/log/django/crm.log

# --------------------------------------------------
# MONITORING (Optional)
# --------------------------------------------------
# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# --------------------------------------------------
# STRIPE SETTINGS (payment links)
# --------------------------------------------------
# Leave unset in dev -- billing/payment-links/ shows a clear error
# instead of creating a link when these aren't configured.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --------------------------------------------------
# ANTHROPIC SETTINGS (AI content generation)
# --------------------------------------------------
# Leave unset in dev -- /ai-content/ shows a clear error on the job
# instead of generating content when this isn't configured.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# --------------------------------------------------
# STABILITY AI SETTINGS (AI image/video generation)
# --------------------------------------------------
# Leave unset in dev -- /ai-content/ shows a clear error on the job
# instead of generating an image/video when this isn't configured.
STABILITY_API_KEY=sk-your-stability-api-key
